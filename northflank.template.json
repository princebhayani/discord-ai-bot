{
  "$schema": "https://api.northflank.com/v1/schemas/combined-service",
  "name": "discord-ticket-ai-bot",
  "description": "Persistent outbound-only Discord Ticket AI Conversation Assistant worker (Sandbox-friendly)",
  "billing": {
    "deploymentPlan": "nf-compute-10"
  },
  "deployment": {
    "instances": 1,
    "docker": {
      "configType": "default"
    }
  },
  "buildSettings": {
    "dockerfile": {
      "buildEngine": "kaniko",
      "dockerFilePath": "/Dockerfile",
      "dockerWorkDir": "/"
    }
  },
  "ports": []
}

