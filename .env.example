# ==============================================================================
# Discord Ticket AI Conversation Assistant — Environment Configuration
# ==============================================================================
# Never commit real secrets (.env is gitignored).
# ==============================================================================

# ------------------------------------------------------------------------------
# A. Render Free Web Service (apps/bot) — 9 Variables
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

SUPABASE_URL=
SUPABASE_SECRET_KEY=

NODE_ENV=production
LOG_LEVEL=info
# PORT is injected automatically by Render (defaults to 3000 locally)
PORT=3000

# Optional bot tuning (safe defaults built-in — no need to set on Render unless customizing):
# TICKET_WEBHOOK_SECRET=
# CLOSURE_RECONCILE_INTERVAL_MS=60000
# BOT_HEARTBEAT_INTERVAL_MS=30000
# SHUTDOWN_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# B. Vercel Dashboard (apps/dashboard) — ONLY 3 Required Variables!
# ------------------------------------------------------------------------------
# On Vercel, you only need these 3 variables:
#   1. SUPABASE_URL          (Project URL from Supabase -> Project Settings -> API)
#   2. SUPABASE_ANON_KEY     (anon / publishable key from Supabase -> Project Settings -> API)
#   3. SUPABASE_SECRET_KEY   (secret / service_role key — server-only)
#
# Optional Vercel variables (only needed for multi-guild DBs or Discord Role allowlists):
#   DISCORD_GUILD_ID=
#   GROQ_API_KEY=
#   DASHBOARD_DISCORD_BOT_TOKEN=
SUPABASE_ANON_KEY=
