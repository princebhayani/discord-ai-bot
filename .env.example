# ==============================================================================
# Discord Ticket AI Conversation Assistant — Environment Configuration
# ==============================================================================
# IMPORTANT:
# - Never commit real secrets (.env is gitignored).
# - Never expose SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, DISCORD_BOT_TOKEN,
#   or GROQ_API_KEY to client-side browser variables (never prefix with NEXT_PUBLIC_).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Render Web Service Configuration (apps/bot)
# ------------------------------------------------------------------------------
NODE_ENV=production
# Render automatically injects PORT in production; defaults to 3000 locally
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 2. Discord Bot Configuration (Render Free Web Service / apps/bot)
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional HMAC secret if the existing ticket bot sends signed lifecycle webhooks
TICKET_WEBHOOK_SECRET=

# Reconciliation interval (ms) to detect channels deleted while bot was offline
CLOSURE_RECONCILE_INTERVAL_MS=60000
# Heartbeat interval (ms) so the dashboard accurately displays bot online status
BOT_HEARTBEAT_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 3. Groq AI Configuration (Server-Side Only — Bot & Dashboard Server Routes)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current production models.
# Examples:
#   openai/gpt-oss-20b       (Supports strict json_schema structured outputs + tools)
#   openai/gpt-oss-120b      (Supports strict json_schema structured outputs + tools)
#   llama-3.3-70b-versatile  (Supports tool use + json_object structured mode)
#   llama-3.1-8b-instant     (High-speed production model, json_object mode)
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 4. Supabase Database & Auth Configuration
# ------------------------------------------------------------------------------
# Public URL & Anon Key (safe for Supabase SSR Auth in Next.js Dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-Only Supabase Credentials (NEVER expose in client code or HTTP health endpoints)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alias also supported interchangeably with SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 5. Next.js Dashboard Configuration (Vercel / apps/dashboard)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_GUILD_ID=
# Optional Discord Bot Token on Dashboard server ONLY if verifying live guild member roles via Discord REST API
DASHBOARD_DISCORD_BOT_TOKEN=
